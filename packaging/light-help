//      // //     // //   //     //      //   // //
//      // // //  /////   //     //      //   ////
//      // //  // // //   //     //      //   // //
//////  //  ////  // //   //      ////   //   //  //
EOF
if [ -n "$VERSION" ]; then
  printf '%s\n' "$VERSION"
fi
cat <<'EOF'

