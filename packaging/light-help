  cd /home/light/light-console
  python3 -c "from light_console import VERSION; print(VERSION)"

Mac repository:
  /Users/miiroseppanen/shieldxl-light-console

  cd /Users/miiroseppanen/shieldxl-light-console
  git describe --tags --always
  git rev-parse --short HEAD


