[Unit]
Description=Shield XL Light Console (OLED + K1-K3 + E1-E3)
Documentation=file:///home/light/light-console/docs/boot.md
After=local-fs.target shieldxl-oled-starting.service shieldxl-oled-shutdown.service NetworkManager.service
Wants=shieldxl-oled-shutdown.service NetworkManager.service
# After NetworkManager.service so WIZ CONTROL restore can talk to nmcli.
# Do not After=network-online.target: that waits for wlan0/LIGHT-CONTROL.
# Boot splash is WantedBy=multi-user.target, not Wants= here. Pulling the
# oneshot (RemainAfterExit=no) from Light Console would re-run STARTING UP
# and hold the splash on ordinary systemctl restart.
# Do not Requires= the splash: OLED failure must not block the UI.
# Do not After=/Wants= dev-spidev0.0.device. On Raspberry Pi OS the
# systemd .device unit can stay inactive while /dev/spidev0.0 exists,
# which leaves this service as a pending job and the OLED blank.
# Rate-limit crash restarts (must live in [Unit], not [Service]).
StartLimitIntervalSec=60
StartLimitBurst=5
# Independent of qlcplus.service. Light Console stays usable if QLC is down.

[Service]
Type=simple
User=light
Group=light
SupplementaryGroups=gpio spi
WorkingDirectory=/home/light/light-console
Environment=PYTHONPATH=/home/light/light-console
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u -m light_console.main --shield
RuntimeDirectory=light-console
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=light-console

[Install]
WantedBy=multi-user.target
