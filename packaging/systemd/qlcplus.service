[Unit]
Description=QLC+ 5.2.2 headless web (Light Console)
Documentation=file:///home/light/light-console/docs/qlc-integration.md
After=network-online.target sound.target local-fs.target
Wants=network-online.target
Wants=qlc-startup-chaser.service
StartLimitIntervalSec=60
StartLimitBurst=5
# Independent of light-console.service. Do not Require= or After= it.

[Service]
Type=simple
User=light
Group=light
WorkingDirectory=/home/light/light-console
Environment=HOME=/home/light
Environment=PYTHONPATH=/home/light/light-console
Environment=QT_QPA_PLATFORM=offscreen
Environment=QT_LOGGING_RULES=qt.qpa.*=false
# Production Pi uses: qlcplus-qml -w -o /home/valot/siirtyma-startup.qxw
# -o is a valueless flag; the path is the positional workspace.
# WebAccess may take minutes after a large Virtual Console refresh. Do not
# SIGTERM during Refresh 2D view. Do not use -9 or POST /loadProject.
ExecStartPre=/usr/bin/python3 -m light_console.midi_wait
ExecStart=/usr/bin/qlcplus-qml -w -o /home/light/shows/master.qxw
TimeoutStartSec=30
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qlcplus

[Install]
WantedBy=multi-user.target
