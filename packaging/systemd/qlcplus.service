[Unit]
Description=QLC+ 5.2.2 headless web (Light Console)
Documentation=file:///home/light/light-console/docs/qlc-integration.md
After=local-fs.target
# Rate-limit crash restarts (must live in [Unit], not [Service]).
StartLimitIntervalSec=60
StartLimitBurst=5
# Independent of light-console.service. Do not Require= or After= it.

[Service]
Type=simple
User=light
Group=light
WorkingDirectory=/home/light/light-console
Environment=PYTHONPATH=/home/light/light-console
Environment=QT_QPA_PLATFORM=offscreen
Environment=QT_LOGGING_RULES=qt.qpa.*=false
# -w only. --open and POST /loadProject block WebAccess on this 5.2.2 QML
# offscreen build (Refresh 2D view, :9999 never/no-longer binds).
ExecStartPre=/usr/bin/python3 -m light_console.midi_wait
ExecStart=/usr/bin/qlcplus-qml -w
TimeoutStartSec=30
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qlcplus

[Install]
WantedBy=multi-user.target
